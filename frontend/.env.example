# Frontend Environment Configuration Template
# Copy this file to .env.local and update the values for your environment

# API Configuration
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# Feature Flags
VITE_ENABLE_ADMIN_PANEL=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=false

# Application Configuration
VITE_APP_TITLE=Cities Game
VITE_APP_DESCRIPTION=A real-time multiplayer word game

# Development Configuration
VITE_NODE_ENV=development
VITE_ENABLE_MOCK_DATA=false

# External Services (optional)
VITE_SENTRY_DSN=optional-sentry-dsn-for-error-tracking
VITE_GOOGLE_ANALYTICS_ID=optional-ga-tracking-id